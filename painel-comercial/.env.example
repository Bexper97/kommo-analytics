# Copie para .env (ou cadastre como variáveis de ambiente na hospedagem).
# O arquivo .env NÃO deve ir para o Git.

# Kommo
KOMMO_BASE_URL=https://cafaz.kommo.com
KOMMO_TOKEN=cole_aqui_o_token_de_longa_duracao

# Banco Postgres (Supabase: Project Settings > Database > Connection string > URI)
DATABASE_URL=postgres://usuario:senha@host:5432/postgres

# Segredo que vai no endereço do webhook: /webhook/kommo/<WEBHOOK_SECRET>
# Gere um texto aleatório longo (ex.: openssl rand -hex 16)
WEBHOOK_SECRET=troque_por_um_texto_aleatorio

# Campos personalizados de lead
KOMMO_FIELD_ENTRADA=2055640
KOMMO_FIELD_INICIO_ATENDIMENTO=2055642
KOMMO_FIELD_MOTIVO_PERDA=1802622

# Regras do painel
# Comercial CLT, Comercial PJ, B2B
FUNIS_VENDA=13459779,13459783,14391607
# Pré-vendas + funis de venda
FUNIS_FONTES=13460403,13459779,13459783,14391607
# Follow-up (CLT e PJ)
ETAPAS_IGNORADAS_PARADAS=103830191,103830231
DIAS_PARADA=2
MINUTOS_SEM_CONTATO=60

# Sincronização de segurança (minutos) e fuso
SYNC_MINUTES=15
TIME_ZONE=America/Sao_Paulo
TZ_OFFSET=-03:00
PORT=3000
