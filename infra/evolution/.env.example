# Copie para ".env" nesta mesma pasta e preencha com valores reais.
# NUNCA commite o arquivo ".env" com segredos de verdade.

# ---------- Evolution API ----------
# Chave usada no header 'apikey' de toda chamada à Evolution API.
EVOLUTION_API_KEY=troque-por-uma-chave-forte-aleatoria

# URL pública (ou IP) pela qual a Evolution API é acessada.
EVOLUTION_SERVER_URL=http://SEU_IP_OU_DOMINIO:8080
EVOLUTION_PORT=8080

EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=troque-por-uma-senha-forte
EVOLUTION_DB_NAME=evolution

# ---------- n8n ----------
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troque-por-uma-senha-forte
# Gere com: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Host/URL pública do n8n (usada para exibir links corretos e nos webhooks)
N8N_HOST=SEU_IP_OU_DOMINIO
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://SEU_IP_OU_DOMINIO:5678/

# Webhook interno: a Evolution API roda no mesmo docker-compose, então
# consegue chamar o n8n direto pelo nome do serviço, sem expor a internet.
N8N_WEBHOOK_URL=http://n8n:5678/webhook/evolution-inbound

TZ=America/Sao_Paulo

# ---------- Usadas pelos workflows do n8n (não pela Evolution API) ----------
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-do-supabase
ANTHROPIC_API_KEY=coloque-sua-chave-da-api-da-anthropic
