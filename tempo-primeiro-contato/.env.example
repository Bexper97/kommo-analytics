# Copie para .env e preencha. O arquivo .env NÃO deve ir para o Git.
KOMMO_BASE_URL=https://cafaz.kommo.com
KOMMO_TOKEN=cole_aqui_o_token_de_longa_duracao

# IDs dos campos personalizados (nível de lead)
KOMMO_FIELD_ENTRADA=2055640
KOMMO_FIELD_INICIO_ATENDIMENTO=2055642

# Fuso usado para agrupar por dia/hora
TIME_ZONE=America/Sao_Paulo
TZ_OFFSET=-03:00

PORT=3000
CACHE_MINUTES=5
# DEMO=1  -> usa dados fictícios, sem chamar a Kommo
