# Copy this file to .env.local and fill in your values.

# Kommo CRM
KOMMO_BASE_URL=https://yoursubdomain.kommo.com
KOMMO_LONG_LIVED_TOKEN=

# Google Gemini
GEMINI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WhatsApp: which self-hosted gateway to use for "Send WhatsApp Report" (evolution | openwa)
WHATSAPP_PROVIDER=evolution

# Evolution API
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# OpenWA (see ./openwa, run via Docker — see README "Self-hosted WhatsApp with OpenWA")
OPENWA_API_URL=http://localhost:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_ID=
